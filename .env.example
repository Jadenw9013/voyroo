# Voyroo environment configuration.
# Copy to .env.local for local dev. On Vercel, set these in Project Settings → Environment Variables.
# With none set, local dev keeps trips in memory (they reset when the server restarts).

# Upstash Redis. Connecting Upstash from the Vercel Marketplace sets these automatically.
# (A direct Upstash database uses UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN instead; either works.)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Signs the cookie that keeps each person in a trip. Any long random string.
# Optional: without it, one is derived from the Redis token.
SESSION_SECRET=

# Optional Google sign-in. All four values (including SESSION_SECRET) are required.
# Create a Google OAuth web client and register this exact callback URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Optional: the passcode for the original Guatemala trip, so nobody has to set it by joining first.
# TRIP_PASSCODE=

# The assistant (Google AI Studio key). Without it, the assistant says it isn't set up; everything else works.
# Google Maps and Search lookups need billing enabled on the key's Google Cloud project (5,000 a month are then free).
# Without it the assistant still answers, just without live lookups. A paid key also keeps prompts out of Google's product training.
GEMINI_API_KEY=
# Optional overrides. Defaults: gemini-3.8-flash, then gemini-3.5-flash-lite and gemini-3.6-flash if it's busy.
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash
# CHAT_THINKING_LEVEL=low

# Trip map pins. Places are looked up with OpenStreetMap's Nominatim, within its usage policy
# (https://operations.osmfoundation.org/policies/nominatim/): one request a second for the whole app, cached.
# "off" stops all lookups at once (Maps links that carry coordinates still work); "stub" is a fixed table for tests.
# GEOCODER=nominatim
# A self-hosted Nominatim instead of the public one:
# NOMINATIM_URL=https://nominatim.example.com/search

# Optional: road times between stops ("About 25 min drive · Leave by 8:35 AM"). A free openrouteservice key
# from https://account.heigit.org (2,000 routes a day). Used on the server only; never exposed to phones.
# Without it, phones show a straight-line estimate, labeled as one.
OPENROUTESERVICE_API_KEY=
# Local testing only: made-up road times with no network. Ignored in production.
# ROUTING_MOCK=1

# Only for a throwaway deploy with no Redis: keeps trips in memory, and they vanish on every cold start.
# ALLOW_MEMORY_STORE=1

# Local testing only: a scripted stand-in for the assistant, no key needed. Ignored in production.
# CHAT_MOCK=1

# Weather comes from Open-Meteo: free for non-commercial use with no key (credited next to every forecast).
# A commercial deploy needs an Open-Meteo API key, which switches to its customer endpoints.
# OPEN_METEO_API_KEY=
# WEATHER=off hides weather; WEATHER=stub answers from fixed numbers for tests and offline development.
# WEATHER=

# Private memories pilot: server-only; all capabilities default off.
# Future media routes/workers must enforce these plus membership/ownership.
MEMORIES_ENABLED=0
RECAP_AI_ENABLED=0
RECAP_RENDERING_ENABLED=0
# Both allowlists must be configured for signed-in pilot participants.
MEMORIES_PILOT_TRIP_IDS=
MEMORIES_PILOT_ACCOUNT_IDS=
