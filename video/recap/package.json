{
  "name": "voyroo-recap-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test domain/*.test.ts",
    "test:editor": "playwright test",
    "test:media": "tsx --test scripts/*.test.ts",
    "import:local": "tsx scripts/import-local.ts",
    "evaluate": "tsx scripts/evaluate.ts",
    "evaluate:summary": "tsx scripts/review-summary.ts",
    "fixtures": "tsx scripts/fixtures.ts",
    "render": "tsx scripts/render.ts",
    "verify": "tsx scripts/verify.ts"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.538",
    "@remotion/player": "4.0.538",
    "@remotion/renderer": "4.0.538",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.538",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
