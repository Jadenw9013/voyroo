{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"], "module": "ESNext",
    "moduleResolution": "bundler", "jsx": "react-jsx", "strict": true,
    "skipLibCheck": true, "esModuleInterop": true, "resolveJsonModule": true,
    "noEmit": true, "types": ["node", "vite/client"]
  },
  "include": ["**/*.ts", "**/*.tsx"], "exclude": ["node_modules", "artifacts", "private"]
}
